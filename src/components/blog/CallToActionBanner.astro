---
/**
 * Reusable CTA banner (primary background, contrast text).
 * Use in blog MDX or page widgets.
 */
export interface Props {
  /** Large heading on the left (e.g. "Stay up to date") */
  heading: string;
  /** CTA button label (e.g. "Contact") */
  ctaText: string;
  /** Link URL – internal path or external URL */
  ctaUrl: string;
  /** If true, CTA opens the newsletter dialog instead of navigating */
  opensNewsletterModal?: boolean;
}

const { heading, ctaText, ctaUrl, opensNewsletterModal = false } = Astro.props;

const isExternal = ctaUrl.startsWith('http://') || ctaUrl.startsWith('https://');
const linkAttrs = isExternal
  ? { href: ctaUrl, rel: 'noopener noreferrer', target: '_blank' }
  : { href: ctaUrl };
---

<div class="call-to-action-banner my-8 rounded-lg bg-primary px-6 py-6 sm:px-8 sm:py-8">
  <div class="flex flex-col items-center gap-4 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-center font-heading text-2xl font-bold tracking-tight sm:text-left sm:text-3xl">{heading}</p>
    {
      opensNewsletterModal ? (
        <button type="button" class="btn-primary shrink-0" data-newsletter-open>
          {ctaText}
        </button>
      ) : (
        <a
          class="btn-primary shrink-0"
          {...linkAttrs}
        >
          {ctaText}
        </a>
      )
    }
  </div>
</div>

<style>
  .call-to-action-banner {
    color: var(--aw-color-primary-contrast, rgb(255 255 255));
  }
  .call-to-action-banner .btn-primary {
    background-color: var(--aw-color-primary-contrast, rgb(255 255 255));
    color: var(--aw-color-primary);
    border-color: var(--aw-color-primary-contrast, rgb(255 255 255));
  }
  .call-to-action-banner .btn-primary:hover {
    opacity: 0.9;
  }
</style>
