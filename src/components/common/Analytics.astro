---
import { ANALYTICS } from 'astrowind:config';
---

{
  ANALYTICS?.vendors?.googleAnalytics?.id && (
    <script
      type="text/partytown"
      data-category="analytics"
      define:vars={{ id: String(ANALYTICS.vendors.googleAnalytics.id) }}
    >
      function loadGoogleAnalytics() {
        var gaScript = document.createElement('script');
        gaScript.async = true;
        gaScript.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
        document.head.appendChild(gaScript);

        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = window.gtag || gtag;
        window.gtag('js', new Date());
        window.gtag('config', id);
      }

      // Delay non-critical GA script so it does not impact initial page load metrics.
      function scheduleGoogleAnalyticsLoad() {
        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(function () {
            window.setTimeout(loadGoogleAnalytics, 3000);
          }, { timeout: 3000 });
          return;
        }

        window.setTimeout(loadGoogleAnalytics, 3000);
      }

      if (document.readyState === 'complete') {
        scheduleGoogleAnalyticsLoad();
      } else {
        window.addEventListener('load', scheduleGoogleAnalyticsLoad, { once: true });
      }
    </script>
  )
}