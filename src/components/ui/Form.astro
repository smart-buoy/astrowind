---
import type { Form as Props } from '~/types';
import Button from '~/components/ui/Button.astro';

const { inputs, textarea, disclaimer, button = 'Contact us', description = '' } = Astro.props;
---

<form name="contact" netlify netlify-honeypot="bot-field">
  <p class="hidden">
    <label>
      Don’t fill this out if you’re human: <input name="bot-field" />
    </label>
  </p>
  {
    inputs &&
      inputs.map(
        ({
          type = 'text',
          name,
          label = '',
          autocomplete = 'on',
          placeholder = '',
          options,
          variant,
          required,
        }) =>
          name &&
          (type === 'radio' && variant === 'toggle' && options?.length ? (
            <div class="mb-6">
              {label && (
                <label class="block text-sm font-medium mb-2">{label}</label>
              )}
              <div
                class="flex w-full p-0.5 rounded-lg border border-gray-200 dark:border-[#4a4a4a] bg-gray-100 dark:bg-[#242424]"
                role="group"
                aria-label={label}
              >
                {options.map((opt, i) => (
                  <label
                    class="cursor-pointer flex-1 text-center py-2.5 px-4 text-sm font-medium rounded-md transition-colors has-[:checked]:bg-primary has-[:checked]:text-white has-[:checked]:shadow"
                  >
                    <input
                      type="radio"
                      name={name}
                      value={opt.value}
                      required={required}
                      class="sr-only"
                    />
                    {opt.label}
                  </label>
                ))}
              </div>
            </div>
          ) : type === 'checkbox' ? (
            <div class="mb-6 flex items-start">
              <div class="mt-0.5 flex">
                <input
                  type="checkbox"
                  name={name}
                  id={name}
                  required={required}
                  class="cursor-pointer mt-1 h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary"
                />
              </div>
              <div class="ml-3">
                <label for={name} class="cursor-pointer select-none text-sm text-gray-700 dark:text-gray-300">
                  {label}
                </label>
              </div>
            </div>
          ) : (
            <div class="mb-6">
              {label && (
                <label for={name} class="block text-sm font-medium">
                  {label}
                </label>
              )}
              <input
                type={type}
                name={name}
                id={name}
                autocomplete={autocomplete}
                placeholder={placeholder}
                required={required}
                class="py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-[#4a4a4a] bg-white dark:bg-[#1f1f1f]"
              />
            </div>
          ))
      )
  }

  {
    textarea && (
      <div>
        <label for="textarea" class="block text-sm font-medium">
          {textarea.label}
        </label>
        <textarea
          id="textarea"
          name={textarea.name ? textarea.name : 'message'}
          rows={textarea.rows ? textarea.rows : 4}
          placeholder={textarea.placeholder}
          required={textarea.required}
          class="py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-[#4a4a4a] bg-white dark:bg-[#1f1f1f]"
        />
      </div>
    )
  }

  {
    disclaimer && (
      <div class="mt-3 flex items-start">
        <div class="flex mt-0.5">
          <input
            id="disclaimer"
            name="disclaimer"
            type="checkbox"
            class="cursor-pointer mt-1 py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-[#4a4a4a] bg-white dark:bg-[#1f1f1f]"
          />
        </div>
        <div class="ml-3">
          <label for="disclaimer" class="cursor-pointer select-none text-sm text-gray-600 dark:text-gray-400">
            {disclaimer.label}
          </label>
          {
            disclaimer.hint && (
              <p
                class="mt-2 text-xs leading-relaxed text-gray-600 dark:text-gray-400 [&_a]:underline [&_a]:text-primary hover:[&_a]:text-primary/80"
                set:html={disclaimer.hint}
              />
            )
          }
        </div>
      </div>
    )
  }

  {
    button && (
      <div class="mt-10 grid">
        <Button variant="primary" type="submit">
          {button}
        </Button>
      </div>
    )
  }

  {
    description && (
      <div class="mt-3 text-center">
        <p class="text-sm text-gray-600 dark:text-gray-400">{description}</p>
      </div>
    )
  }
</form>
