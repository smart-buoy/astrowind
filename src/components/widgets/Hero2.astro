---
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';

import type { Hero as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,

  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  image = await Astro.slots.render('image'),

  id,
  bg = await Astro.slots.render('bg'),
} = Astro.props;

const imageMetadata =
  typeof image === 'object' && image !== null && 'width' in image && 'height' in image ? image : undefined;
const imageAspectRatio = imageMetadata
  ? Number(imageMetadata.width) / Number(imageMetadata.height)
  : 16 / 9;
const heroImageWidth = imageMetadata ? Math.min(Number(imageMetadata.width), 1200) : 1200;
const heroImageHeight = Math.round(heroImageWidth / imageAspectRatio);
const hasStringImage = typeof image === 'string';
const hasObjectImage = typeof image === 'object' && image !== null;
const imageObjectProps: Record<string, unknown> | undefined = hasObjectImage ? (image as Record<string, unknown>) : undefined;
const hasImage = hasStringImage || Boolean(imageObjectProps);
---

<section class="relative overflow-hidden md:-mt-[76px] not-prose" {...id ? { id } : {}}>
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <slot name="bg">
      {bg ? <Fragment set:html={bg} /> : null}
    </slot>
  </div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="pt-0 md:pt-[76px] pointer-events-none"></div>
    <div class="py-10 sm:py-14 md:py-20 lg:flex lg:items-center lg:gap-12 lg:py-20">
      <div class="relative basis-1/2 text-center lg:text-left">
        <div class="pointer-events-none absolute inset-y-2 -left-5 hidden w-56 rounded-full bg-gradient-to-br from-primary/20 via-primary/5 to-transparent blur-3xl lg:block" aria-hidden="true"></div>
        <div class="relative mx-auto max-w-2xl lg:mx-0">
        {
          tagline && (
            <p
              class="text-sm font-bold tracking-[0.2em] text-secondary uppercase intersect-once intersect-quarter motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0"
              set:html={tagline}
            />
          )
        }
        {
          title && (
            <h1
              class="mt-3 mb-5 font-heading text-4xl font-bold leading-tight tracking-tight dark:text-gray-200 intersect-once intersect-quarter motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 sm:text-5xl lg:text-6xl"
              set:html={title}
            />
          )
        }
        <div class="mx-auto max-w-xl lg:mx-0 lg:max-w-none">
          {
            subtitle && (
              <p
                class="mb-7 text-lg text-muted dark:text-slate-300 intersect-once intersect-quarter motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 sm:text-xl"
                set:html={subtitle}
              />
            )
          }

          {
            actions && (
              <div class="mx-auto flex max-w-xs flex-nowrap flex-col items-center gap-4 intersect-once intersect-quarter motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 sm:max-w-md sm:flex-row sm:justify-center lg:mx-0 lg:max-w-7xl lg:items-start lg:justify-start">
                {Array.isArray(actions) ? (
                  actions.map((action) => (
                    <div class="flex w-full justify-center sm:w-auto">
                      <Button {...(action || {})} class="w-full sm:mb-0" />
                    </div>
                  ))
                ) : (
                  <Fragment set:html={actions} />
                )}
              </div>
            )
          }
        </div>
        {content && <Fragment set:html={content} />}
      </div>
      </div>
      <div class="mt-10 basis-1/2 lg:mt-0">
        {
          hasImage && (
            <div class="relative m-auto max-w-2xl overflow-hidden rounded-3xl border border-gray-200/70 bg-white/35 shadow-[0_28px_80px_-42px_rgba(15,23,42,0.62)] ring-1 ring-white/75 backdrop-blur-sm dark:border-slate-700/70 dark:bg-slate-900/30 dark:ring-slate-700/60 lg:max-w-none intersect-once intersect-no-queue intersect-quarter motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0">
              {hasStringImage ? (
                <Fragment set:html={image} />
              ) : imageObjectProps ? (
                <Image
                  class="mx-auto h-auto w-full object-cover"
                  widths={[400, 768, 1024, 2040]}
                  sizes="(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 2040px"
                  loading="eager"
                  fetchpriority="high"
                  layout="cover"
                  width={heroImageWidth}
                  height={heroImageHeight}
                  {...imageObjectProps}
                />
              ) : null}
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
