---
import { getCollection } from 'astro:content';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '~/i18n/utils';
import Button from '~/components/ui/Button.astro';
import Image from '~/components/common/Image.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import PageCarousel from '~/components/widgets/PageCarousel.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import CallToActionBanner from '~/components/blog/CallToActionBanner.astro';
import NewsletterModal from '~/components/common/NewsletterModal.astro';
import { Icon } from 'astro-icon/components';
import VideoPlayer from '~/components/common/VideoPlayer.astro';
import { formatFrontmatterRichText } from '~/i18n/richText';
import skipperHeroImage from '~/assets/images/app2.jpg';
import skipperVideoPosterImage from '~/assets/images/boat.jpg';

const appStoreImg = '~/assets/images/app-store.png';
const appStoreDownloadLink = '#';

const googlePlayImg = '~/assets/images/google-play.png';
const googlePlayDownloadLink = '#';

const language = getLangFromUrl(Astro.url);
const t = useTranslations(language);
const translatePath = useTranslatedPath(language);
const contactUrl = translatePath(getPermalink('/contact'));

const faqEntries = await getCollection('faq');
const faqs = faqEntries
  .filter((entry) => entry.data.area === 'skipper')
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .map((entry) => {
    const d = entry.data;
    const lang = language as 'en' | 'de';
    return {
      title: (d.question && (d.question[lang] ?? d.question.en)) ?? '',
      description: (d.answer && (d.answer[lang] ?? d.answer.en)) ?? '',
    };
  });

const pageCarouselEntries = await getCollection('pageCarousel');
const carouselItems = pageCarouselEntries
  .filter((entry) => entry.data.area === 'skipper')
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .map((entry) => {
    const d = entry.data;
    const lang = language as 'en' | 'de';
    const localizedTitle = (d.title && (d.title[lang] ?? d.title.en)) ?? '';
    return {
      image: d.image,
      imageAlt: (d.imageAlt && (d.imageAlt[lang] ?? d.imageAlt.en)) ?? localizedTitle,
      title: localizedTitle,
      description: (d.description && (d.description[lang] ?? d.description.en)) ?? '',
    };
  });

const skipperAdvantagesEntries = await getCollection('skipperAdvantages');
const skipperAdvantages = skipperAdvantagesEntries
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .map((entry) => {
    const d = entry.data;
    const lang = language as 'en' | 'de';
    return {
      title: (d.title && (d.title[lang] ?? d.title.en)) ?? '',
      descriptionHtml: formatFrontmatterRichText((d.description && (d.description[lang] ?? d.description.en)) ?? ''),
      icon: d.icon ?? 'tabler:circle-check',
    };
  });

---

<!-- Hero Widget ******************* -->
<Hero2
  tagline={t('skipper.hero.tagline')}
  image={{
    src: skipperHeroImage,
    alt: 'SmartBuoy App Image',
  }}
>
  <Fragment slot="title">
    {t('skipper.hero.headline')}
  </Fragment>

  <Fragment slot="subtitle">
    {t('skipper.hero.subtitle')}
  </Fragment>

  <div slot="actions" class="flex max-w-sm gap-4">
    <Button variant="primary" type="button" data-newsletter-open>{t('skipper.cta.button')}</Button>
  </div>
</Hero2>

<NewsletterModal />

<VideoPlayer
  id="skipper-video"
  videoSrc="https://cdn.smartbuoy.eu/SMARTBUOY_TEST_VERS_1.mp4"
  poster={skipperVideoPosterImage.src}
  playAriaLabel="Play skipper video"
/>

<!-- Features Widget *************** -->

{
  skipperAdvantages.length > 0 && (
    <WidgetWrapper id="features" containerClass="max-w-6xl">
      <Headline
        title={t('skipper.highlights.title')}
        subtitle={t('skipper.highlights.sub-title')}
        tagline={t('skipper.highlights.tagline')}
      />
      <div class="grid gap-x-10 gap-y-14 sm:grid-cols-2">
        {skipperAdvantages.map((advantage) => (
          <article class="max-w-xl">
            <div class="flex items-center gap-4">
              <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-primary text-white">
                <Icon name={advantage.icon} class="h-7 w-7" />
              </div>
              <h3 class="text-xl font-bold dark:text-white">{advantage.title}</h3>
            </div>
            <div class="skipper-advantages-richtext mt-4 text-muted dark:text-slate-300" set:html={advantage.descriptionHtml} />
          </article>
        ))}
      </div>
    </WidgetWrapper>
  )
}

{
  carouselItems.length > 0 && (
    <PageCarousel
      id="skipper-carousel"
      title={t('skipper.carousel.title')}
      subtitle={t('skipper.carousel.sub-title')}
      tagline={t('skipper.carousel.tagline')}
      items={carouselItems}
    />
  )
}

<div class="mx-auto max-w-6xl px-4 md:px-6">
  <CallToActionBanner
    heading={t('shared-cta.heading')}
    ctaText={t('skipper.cta.banner-button')}
    ctaUrl={contactUrl}
    opensNewsletterModal
  />
</div>

<!-- Stats Widget ****************** -->
{
  false && (
    <Stats
      title={t('skipper.statistics.title')}
      stats={[
        { amount: '20K', icon: 'tabler:download' },
        { amount: '18.5K', icon: 'tabler:users' },
        { amount: '4.7', icon: 'tabler:user-star' },
      ]}
    />
  )
}

<!-- FAQs Widget ******************* -->
{
  faqs.length > 0 && (
    <FAQs
      title={t('skipper.faq.title')}
      subtitle={t('skipper.faq.sub-title')}
      tagline={t('skipper.faq.tagline')}
      classes={{ container: 'max-w-6xl' }}
      items={faqs}
    />
  )
}

<!-- CallToAction Widget *********** -->

{ false && (
<CallToAction id="download" title={t('skipper.call-to-action.title')} subtitle={t('skipper.call-to-action.sub-title')}>
  <div slot="actions" class="flex max-w-sm gap-4">
    <Button variant="link" href={appStoreDownloadLink}>
      <Image src={appStoreImg} alt="App Store Image" width={200} />
    </Button>

    <Button variant="link" href={googlePlayDownloadLink}>
      <Image src={googlePlayImg} alt="Google Play Image" width={200} />
    </Button>
  </div>
</CallToAction>
)}


<style>
  .skipper-advantages-richtext :global(p) {
    margin: 0 0 0.8rem;
  }

  .skipper-advantages-richtext :global(p:last-child) {
    margin-bottom: 0;
  }

  .skipper-advantages-richtext :global(ul) {
    margin: 0 0 0.8rem;
    padding-left: 1.25rem;
    list-style: disc;
  }

  .skipper-advantages-richtext :global(ul:last-child) {
    margin-bottom: 0;
  }

  .skipper-advantages-richtext :global(li) {
    margin: 0.2rem 0;
  }
</style>
