---
import { getCollection } from 'astro:content';
import FAQs from '~/components/widgets/FAQs.astro';
import { getPermalink } from '~/utils/permalinks';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '~/i18n/utils';
import Button from '~/components/ui/Button.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import PageCarousel from '~/components/widgets/PageCarousel.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import CallToActionBanner from '~/components/blog/CallToActionBanner.astro';
import NewsletterModal from '~/components/common/NewsletterModal.astro';
import { Icon } from 'astro-icon/components';
import VideoPlayer from '~/components/common/VideoPlayer.astro';
import { formatFrontmatterRichText } from '~/i18n/richText';
import operatorHeroImage from '~/assets/images/dashboard.jpg';

const language = getLangFromUrl(Astro.url);
const t = useTranslations(language);
const translatePath = useTranslatedPath(language);
const contactUrl = translatePath(getPermalink('/contact'));

const faqEntries = await getCollection('faq');
const faqs = faqEntries
  .filter((entry) => entry.data.area === 'operator')
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .map((entry) => {
    const d = entry.data;
    const lang = language as 'en' | 'de';
    return {
      title: (d.question && (d.question[lang] ?? d.question.en)) ?? '',
      description: (d.answer && (d.answer[lang] ?? d.answer.en)) ?? '',
    };
  });

const pageCarouselEntries = await getCollection('pageCarousel');
const carouselItems = pageCarouselEntries
  .filter((entry) => entry.data.area === 'operator')
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .map((entry) => {
    const d = entry.data;
    const lang = language as 'en' | 'de';
    const localizedTitle = (d.title && (d.title[lang] ?? d.title.en)) ?? '';
    return {
      image: d.image,
      imageAlt: (d.imageAlt && (d.imageAlt[lang] ?? d.imageAlt.en)) ?? localizedTitle,
      title: localizedTitle,
      description: (d.description && (d.description[lang] ?? d.description.en)) ?? '',
    };
  });

const operatorAdvantagesEntries = await getCollection('operatorAdvantages');
const operatorAdvantages = operatorAdvantagesEntries
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .map((entry) => {
    const d = entry.data;
    const lang = language as 'en' | 'de';
    return {
      title: (d.title && (d.title[lang] ?? d.title.en)) ?? '',
      descriptionHtml: formatFrontmatterRichText((d.description && (d.description[lang] ?? d.description.en)) ?? ''),
      icon: d.icon ?? 'tabler:circle-check',
    };
  });
---

<!-- Hero Widget ******************* -->
<Hero2
  tagline={t('operator.hero.tagline')}
  image={{
    src: operatorHeroImage,
    alt: 'SmartBuoy Dashboard Image',
  }}
>
  <Fragment slot="title">
    <span class="text-primary dark:text-white highlight">{t('operator.hero.title')}</span>
  </Fragment>

  <Fragment slot="subtitle">
    {t('operator.hero.sub-title')}
  </Fragment>

  <div slot="actions" class="flex max-w-sm gap-4">
    <Button variant="primary" type="button" data-newsletter-open>{t('operator.cta.button')}</Button>
  </div>
</Hero2>

<NewsletterModal />

<VideoPlayer
  id="operator-video"
  videoSrc="https://cdn.smartbuoy.eu/SMARTBUOY_TEST_VERS_2.mp4"
  poster={operatorHeroImage.src}
  playAriaLabel="Play operator video"
/>

<!-- Features Widget *************** -->

{
  operatorAdvantages.length > 0 && (
    <WidgetWrapper id="features" containerClass="max-w-6xl">
      <Headline
        title={t('operator.highlights.title')}
        subtitle={t('operator.highlights.sub-title')}
        tagline={t('operator.highlights.tagline')}
      />
      <div class="grid gap-x-10 gap-y-14 sm:grid-cols-2">
        {operatorAdvantages.map((advantage) => (
          <article class="max-w-xl">
            <div class="flex items-center gap-4">
              <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-primary text-white">
                <Icon name={advantage.icon} class="h-7 w-7" />
              </div>
              <h3 class="text-xl font-bold dark:text-white">{advantage.title}</h3>
            </div>
            <div class="operator-advantages-richtext mt-4 text-muted dark:text-slate-300" set:html={advantage.descriptionHtml} />
          </article>
        ))}
      </div>
    </WidgetWrapper>
  )
}

{
  carouselItems.length > 0 && (
    <PageCarousel
      id="operator-carousel"
      title={t('operator.carousel.title')}
      subtitle={t('operator.carousel.sub-title')}
      tagline={t('operator.carousel.tagline')}
      items={carouselItems}
    />
  )
}

<div class="mx-auto max-w-6xl px-4 md:px-6">
  <CallToActionBanner
    heading={t('shared-cta.heading')}
    ctaText={t('operator.cta.banner-button')}
    ctaUrl={contactUrl}
    opensNewsletterModal
  />
</div>

<!-- FAQs Widget ******************* -->
{
  faqs.length > 0 && (
    <FAQs
      title={t('operator.faq.title')}
      subtitle={t('operator.faq.sub-title')}
      tagline={t('operator.faq.tagline')}
      classes={{ container: 'max-w-6xl' }}
      items={faqs}
    />
  )
}

<style>
  .operator-advantages-richtext :global(p) {
    margin: 0 0 0.8rem;
  }

  .operator-advantages-richtext :global(p:last-child) {
    margin-bottom: 0;
  }

  .operator-advantages-richtext :global(ul) {
    margin: 0 0 0.8rem;
    padding-left: 1.25rem;
    list-style: disc;
  }

  .operator-advantages-richtext :global(ul:last-child) {
    margin-bottom: 0;
  }

  .operator-advantages-richtext :global(li) {
    margin: 0.2rem 0;
  }
</style>
